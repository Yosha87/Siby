set ::moderne::logosmoteurs::donnees(autre,72) {}
set ::moderne::logosmoteurs::donnees(autre,96) {}
set ::moderne::logosmoteurs::donnees(alterego,48) {}
set ::moderne::logosmoteurs::donnees(alterego,72) {}
set ::moderne::logosmoteurs::donnees(alterego,96) {}

### Tk image of an engine logo (toby, stockfish, leela, autre, alterego), about
### 48 points: the stored size closest to the screen scaling
proc ::moderne::logosmoteurs::image {cle} {
  variable donnees
  set s [expr {max(1.0, [tk scaling] * 72 / 96.0)}]
  set t 48
  foreach x {48 72 96} { if {abs($x - 48 * $s) < abs($t - 48 * $s)} { set t $x } }
  set img ::moderne::logosmoteurs::$cle$t
  if {$img ni [::image names]} {
    if {![info exists donnees($cle,$t)]} { return {} }
    ::image create photo $img -format png -data $donnees($cle,$t)
  }
  return $img
}

