namespace eval ::moderne::logosmoteurs {
  variable donnees
  array set donnees {}
}

set ::moderne::logosmoteurs::donnees(toby,48) {}
set ::moderne::logosmoteurs::donnees(toby,72) {}
set ::moderne::logosmoteurs::donnees(toby,96) {}
set ::moderne::logosmoteurs::donnees(stockfish,48) {}
set ::moderne::logosmoteurs::donnees(stockfish,72) {}
set ::moderne::logosmoteurs::donnees(stockfish,96) {}
