###
### Siby: piece sets of Lichess (free licenses), in bitmaps/pieces/<set>/:
### a PNG strip per board size (12 pieces), and nom.txt (the name shown).
### Generated by outils/generer_pieces_lichess.sh. The strips are read
### only when the set is chosen (not embedded like cburnett).
###
### installer is called by tcl/bitmaps.tcl once SCID's sets are known,
### before the current set is loaded.
###

namespace eval ::moderne::pieces {
  variable jeux        ;# jeux(name) = folder
  array set jeux {}
}

### Folder bitmaps/pieces (installed next to Siby or in the share folder)
proc ::moderne::pieces::dossier {} {
  set candidats {}
  if {[info exists ::scidShareDir]} { lappend candidats [file join $::scidShareDir bitmaps pieces] }
  if {[info exists ::scidExeDir]} {
    lappend candidats [file join $::scidExeDir bitmaps pieces] \
        [file normalize [file join $::scidExeDir .. share scid bitmaps pieces]] \
        [file normalize [file join $::scidExeDir .. Resources bitmaps pieces]]
  }
  lappend candidats [file join [file dirname [info nameofexecutable]] bitmaps pieces] \
      [file normalize [file join [file dirname [info nameofexecutable]] .. share scid bitmaps pieces]]
  foreach d $candidats {
    if {[file isdirectory $d]} { return $d }
  }
  return {}
}

proc ::moderne::pieces::installer {} {
  variable jeux
  set d [dossier]
  if {$d eq {}} { return }
  foreach sous [lsort [glob -nocomplain -types d -directory $d *]] {
    if {[catch {
      set c [open [file join $sous nom.txt] r]
      set nom [string trim [read $c]]
      close $c
    }] || $nom eq {}} { continue }
    set jeux($nom) $sous
    if {$nom ni $::boardStyles} { lappend ::boardStyles $nom }
  }
  if {[llength [info commands ::setPieceData_origine]]} { return }
  rename ::setPieceData ::setPieceData_origine
  proc ::setPieceData {font size} {
    ::moderne::pieces::charger $font $size
    ::setPieceData_origine $font $size
  }
}

### Strip of set font at size, read from its file the first time
proc ::moderne::pieces::charger {font size} {
  variable jeux
  if {![info exists jeux($font)] || [info exists ::pieceImageData($font,$size)]} { return }
  set f [file join $jeux($font) $size.png]
  if {![file exists $f]} { return }
  if {[catch {
    set c [open $f rb]
    set donnees [read $c]
    close $c
    set ::pieceImageData($font,$size) [binary encode base64 $donnees]
  }]} { return }
}

### Board menu: the piece sets (Lichess's first, then SCID's)
proc ::moderne::pieces::menu {m} {
  variable jeux
  set lichess [concat Cburnett [lsort [array names jeux]]]
  foreach nom $lichess {
    if {$nom ni $::boardStyles} { continue }
    $m add radiobutton -label $nom -variable ::boardStyle -value $nom \
        -command [list ::moderne::pieces::choisir $nom]
  }
  $m add separator
  foreach nom $::boardStyles {
    if {$nom in $lichess} { continue }
    $m add radiobutton -label "$nom ([::moderne::tr classique classic])" -variable ::boardStyle -value $nom \
        -command [list ::moderne::pieces::choisir $nom]
  }
}

proc ::moderne::pieces::choisir {nom} {
  set ::boardStyle $nom
  foreach size $::boardSizes { setPieceData $nom $size }
  catch {updateBoard}
  catch {::moderne::prise::basculer}
}

### End Siby
