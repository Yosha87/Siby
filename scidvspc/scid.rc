#include <windows.h>

#define RESOURCE_INCLUDED

//
// Icon
//

scid                      ICON    DISCARDABLE     "icons/siby.ico"

//
// Siby: manifest (current Windows controls in the native dialogs)
//

1                         24      "siby.exe.manifest"

//
// Siby: product name and version (Properties › Details; required for
// code signing by SignPath: the product name is the project's, the same
// version in every build of a release)
//

1 VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName",      "Yosha Iglesias"
      VALUE "FileDescription",  "Siby"
      VALUE "FileVersion",      "1.0 beta"
      VALUE "InternalName",     "Siby"
      VALUE "LegalCopyright",   "GNU GPL v2; based on SCID vs. PC"
      VALUE "OriginalFilename", "Siby.exe"
      VALUE "ProductName",      "Siby"
      VALUE "ProductVersion",   "1.0 beta"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
